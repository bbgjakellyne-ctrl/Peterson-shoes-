# GEMINI_API_KEY: Required for Peterson Shoes AI Assistant (@google/genai).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE / POSTGRESQL (Opcional — O sistema possui persistência nativa integrada e sincroniza automaticamente quando configurado)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# MERCADO PAGO (Opcional — Modo Homologação/Sandbox ativo por padrão)
MERCADO_PAGO_ACCESS_TOKEN=""
MERCADO_PAGO_LIVE_CHARGES_ENABLED="false"
MERCADO_PAGO_WEBHOOK_SECRET=""

# CREDENCIAIS DO PAINEL ADMINISTRATIVO PETERSON SHOES
# Defina uma senha forte nas variáveis de ambiente do servidor (Secrets) ou configure no primeiro acesso restrito em /?acesso=admin
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_SESSION_SECRET=""

# WHATSAPP (Atendimento à Cliente e Envio de Fichas de Produção ao Fabricante)
WHATSAPP_STORE_NUMBER="5562984998265"

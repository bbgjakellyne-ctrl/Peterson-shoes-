{
  "version": 2,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/index.js?__path=sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/index.js?__path=robots.txt"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js?__path=$1"
    },
    {
      "source": "/((?!api/|instagram/|assets/|sitemap\\.xml|robots\\.txt).*)",
      "destination": "/index.html"
    }
  ]
}

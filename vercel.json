{
  "version": 2,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/assets/peterson-reels-privado-admin.mp4",
      "headers": [
        {
          "key": "Content-Type",
          "value": "video/mp4"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"peterson-shoes-reels-campanha-nova.mp4\""
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/index.js?__path=sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/index.js?__path=robots.txt"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js?__path=$1"
    },
    {
      "source": "/((?!api/|instagram/|assets/|sitemap\\.xml|robots\\.txt).*)",
      "destination": "/index.html"
    }
  ]
}
